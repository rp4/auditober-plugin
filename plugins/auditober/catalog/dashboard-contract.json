  "systemDashboardTypes": [
    "AI_ACTIVITY",
    "CAPACITY_MONITORING",
    "EXECUTIVE",
    "MY_WORK",
    "OPERATIONAL",
    "RISK_CONTROL_MATRIX"
  ],
  "routesByType": {
    "ai-activity": {
      "path": "/dashboards/ai-activity",
      "title": "AI Activity",
      "systemType": "AI_ACTIVITY",
      "parameters": [
        "range",
        "scope",
        "filter",
        "USER_OUTCOMES.q",
        "USER_OUTCOMES.sort",
        "STEP_REJECTIONS.q",
        "STEP_REJECTIONS.sort"
      ],
      "values": {
        "range": [
          "6m",
          "12m",
          "ytd"
        ],
        "USER_OUTCOMES.sort": [
          "approved.asc",
          "approved.desc",
          "rejected.asc",
          "rejected.desc",
          "pending.asc",
          "pending.desc",
          "failed.asc",
          "failed.desc",
          "total.asc",
          "total.desc"
        ],
        "STEP_REJECTIONS.sort": [
          "reviewed.asc",
          "reviewed.desc",
          "rejected.asc",
          "rejected.desc",
          "rejectionPercent.asc",
          "rejectionPercent.desc"
        ]
      },
      "queries": [
        "systemDashboardSnapshot",
        "systemDashboardTable"
      ],
      "notes": "Suggestion usage and outcome movement",
      "scopeSource": "ITEM_TYPE_SCOPES",
      "repeatedParameters": [
        "filter"
      ]
    },
    "audit-plan": {
      "path": "/dashboards/audit-plan",
      "title": "Audit Plan",
      "systemType": null,
      "parameters": [
        "year"
      ],
      "values": {},
      "queries": [
        "auditPlanDashboard"
      ],
      "notes": "Audit plan by year (2000–2100). Use year, not fy, range or audit."
    },
    "capacity-monitoring": {
      "path": "/dashboards/capacity-monitoring",
      "title": "Capacity Monitoring",
      "systemType": "CAPACITY_MONITORING",
      "parameters": [
        "range",
        "scope",
        "entity",
        "filter"
      ],
      "values": {
        "range": [
          "6m",
          "12m",
          "ytd"
        ]
      },
      "queries": [
        "systemDashboardSnapshot",
        "systemDashboardTable"
      ],
      "notes": "Owner workload, due work, and late work",
      "scopeSource": "ITEM_TYPE_SCOPES",
      "repeatedParameters": [
        "filter"
      ]
    },
    "compliance-requirements": {
      "path": "/dashboards/compliance-requirements",
      "title": "Compliance Requirements",
      "systemType": null,
      "parameters": [
        "frameworks",
        "applicability",
        "implementation",
        "q"
      ],
      "values": {},
      "queries": [
        "complianceRequirementsDashboard"
      ],
      "notes": "Requirement applicability and implementation. Resolve framework tokens live and use the declared applicability/implementation values."
    },
    "executive": {
      "path": "/dashboards/executive",
      "title": "Executive",
      "systemType": "EXECUTIVE",
      "parameters": [
        "range",
        "scope",
        "filter"
      ],
      "values": {
        "range": [
          "6m",
          "12m",
          "ytd"
        ]
      },
      "queries": [
        "systemDashboardSnapshot",
        "systemDashboardTable"
      ],
      "notes": "Enterprise assurance posture and decisions",
      "scopeSource": "CANONICAL_REGISTER_DOMAIN_SOURCES",
      "repeatedParameters": [
        "filter"
      ]
    },
    "issues-remediations": {
      "path": "/dashboards/issues-remediations",
      "title": "Issues Remediations",
      "systemType": null,
      "parameters": [
        "audit",
        "fy"
      ],
      "values": {},
      "queries": [
        "issuesRemediationsDashboard"
      ],
      "notes": "Open issues, overdue remediation and validation. Only audit and fy filter the URL. past_due means the earliest open linked remediation target is before today. For overdue-only answers select issues.dueState=past_due and use daysLate/counts.pastDue; check issuesCapped and linksCapped before claiming complete coverage. Link the wider view as context."
    },
    "item-type-register": {
      "path": "/dashboards/register/<slug>",
      "title": "Item type register",
      "systemType": null,
      "parameters": [
        "range",
        "fieldFilters",
        "filter"
      ],
      "values": {
        "range": [
          "6m",
          "12m",
          "ytd"
        ]
      },
      "queries": [
        "itemTypeDashboardSnapshot",
        "itemTypeDashboardDetails"
      ],
      "notes": "A verified active register row supplies configJson.itemTypeSlug. range=6m|12m|ytd; fieldFilters is a JSON object of live field keys to string arrays; filter is a returned selection key. Never infer an available register from item-type-register alone.",
      "repeatedParameters": [
        "filter"
      ]
    },
    "model-inventory": {
      "path": "/dashboards/model-inventory",
      "title": "Model Inventory",
      "systemType": null,
      "parameters": [
        "model"
      ],
      "values": {},
      "queries": [
        "modelInventoryDashboard"
      ],
      "notes": "Model register and assurance. Resolve the model item represented by the selection live."
    },
    "my-work": {
      "path": "/dashboards/my-work",
      "title": "My Work",
      "systemType": "MY_WORK",
      "parameters": [
        "range",
        "scope",
        "filter"
      ],
      "values": {
        "range": [
          "6m",
          "12m",
          "ytd"
        ]
      },
      "queries": [
        "systemDashboardSnapshot",
        "systemDashboardTable"
      ],
      "notes": "A prioritized view of work requiring action",
      "scopeSource": "ITEM_TYPE_SCOPES",
      "repeatedParameters": [
        "filter"
      ]
    },
    "operational": {
      "path": "/dashboards/operations",
      "title": "Operational",
      "systemType": "OPERATIONAL",
      "parameters": [
        "range",
        "scope",
        "filter"
      ],
      "values": {
        "range": [
          "6m",
          "12m",
          "ytd"
        ]
      },
      "queries": [
        "systemDashboardSnapshot",
        "systemDashboardTable"
      ],
      "notes": "Workflow throughput, delay, and accumulated work",
      "scopeSource": "ITEM_TYPE_SCOPES",
      "repeatedParameters": [
        "filter"
      ]
    },
    "personnel": {
      "path": "/dashboards/personnel",
      "title": "Personnel",
      "systemType": null,
      "parameters": [
        "focus",
        "template",
        "after",
        "first"
      ],
      "values": {
        "first": [
          "6",
          "12",
          "24"
        ]
      },
      "queries": [
        "personnelDashboard",
        "personnelDashboardPeople",
        "personnelDashboardTemplates"
      ],
      "notes": "People and reporting lines. focus is a live personnel item ID; template is a live template ID; first=6|12|24; after is an opaque returned cursor. Clear after when focus or template changes."
    },
    "policy-exceptions": {
      "path": "/dashboards/policy-exceptions",
      "title": "Policy Exceptions",
      "systemType": null,
      "parameters": [
        "scope",
        "type",
        "framework",
        "q"
      ],
      "values": {
        "scope": [
          "open",
          "all"
        ]
      },
      "queries": [
        "policyExceptionsDashboard"
      ],
      "notes": "Policy waiver approvals and expiry. scope=open|all; type/framework refer to the waived policy."
    },
    "policy-lifecycle": {
      "path": "/dashboards/policy-lifecycle",
      "title": "Policy Lifecycle",
      "systemType": null,
      "parameters": [
        "type",
        "framework",
        "templates",
        "q",
        "owner",
        "status",
        "review"
      ],
      "values": {
        "review": [
          "overdue",
          "due",
          "due_30",
          "due_60",
          "due_90",
          "later",
          "no_date"
        ]
      },
      "queries": [
        "policyLifecycleDashboard"
      ],
      "notes": "Policy review workflow, calendar, owner and status. Resolve type/framework/owner/status live; review uses the checked fixed tokens."
    },
    "rcm": {
      "path": "/dashboards/rcm",
      "title": "Risk Control Matrix (RCM)",
      "systemType": "RISK_CONTROL_MATRIX",
      "parameters": [
        "range",
        "entity",
        "filter",
        "RCM_MATRIX.audit",
        "RCM_MATRIX.type",
        "RCM_MATRIX.coverage",
        "RCM_MATRIX.q",
        "RCM_MATRIX.sort"
      ],
      "values": {
        "range": [
          "6m",
          "12m",
          "ytd"
        ],
        "RCM_MATRIX.sort": [
          "item.asc",
          "item.desc",
          "audit.asc",
          "audit.desc",
          "coverage.asc",
          "coverage.desc",
          "signedOff.asc",
          "signedOff.desc"
        ]
      },
      "queries": [
        "systemDashboardSnapshot",
        "systemDashboardTable"
      ],
      "notes": "Risk and control coverage for an audit. entity is its live audit ID. RCM_MATRIX filter values come from systemDashboardTable.filterOptions; scope has no domain selector.",
      "scopeSource": "null",
      "repeatedParameters": [
        "filter"
      ]
    },
    "risks": {
      "path": "/dashboards/risks",
      "title": "Risks",
      "systemType": null,
      "parameters": [
        "categories",
        "treatments",
        "templates",
        "q",
        "owner"
      ],
      "values": {},
      "queries": [
        "risksDashboard"
      ],
      "notes": "Open risks, treatment, owner and linked work. categories/treatments use live field options; none means no treatment; templates are risk-template IDs."
    },
